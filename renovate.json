{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Stockholm",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/tool_bootstrap\\.py$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+UV_VERSION = \"(?<currentValue>[^\"]+)\""]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["uses: astral-sh/setup-uv@[^\\n]+(?:\\n\\s+[^\\n]+)*?\\n\\s+version: \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "uv"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"],
    "automerge": false,
    "addLabels": ["dependencies", "lockfile-maintenance"],
    "commitMessageAction": "Refresh lockfile"
  },
  "packageRules": [
    {
      "description": "Group uv CLI, workflow steps, and Docker image updates together into a single atomic toolchain update so CI runners, bootstrap scripts, and container images remain strictly synchronized to the same uv release.",
      "matchPackageNames": ["uv", "ghcr.io/astral-sh/uv"],
      "groupName": "uv toolchain",
      "groupSlug": "uv-toolchain",
      "automerge": false,
      "addLabels": ["dependencies", "toolchain", "needs-manual-review"]
    },
    {
      "description": "Group cryptography and pyOpenSSL together: pyOpenSSL places an explicit upper-bound ceiling on the cryptography version it accepts (e.g. pyOpenSSL 26.3.0 requires cryptography<50). Bumping them independently creates impossible pip resolves. A single combined PR ensures both floors are updated only when a new pyOpenSSL release extends its cryptography upper bound.",
      "matchPackageNames": ["cryptography", "pyOpenSSL"],
      "groupName": "cryptography + pyOpenSSL (coupled release)",
      "groupSlug": "cryptography-pyopenssl",
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "addLabels": ["dependencies", "needs-manual-review"]
    },
    {
      "description": "Group Python dev tool updates (mypy, ruff, bandit, pip-audit) into a single weekly reviewed PR with a 3-day minimum release age.",
      "matchPackageNames": ["mypy", "ruff", "bandit", "pip-audit"],
      "groupName": "Python development tools",
      "groupSlug": "python-dev-tools",
      "schedule": ["before 7am on monday"],
      "minimumReleaseAge": "3 days",
      "automerge": false,
      "addLabels": ["dependencies", "python", "needs-manual-review"]
    },
    {
      "description": "Group pytest ecosystem updates into Python development tools weekly reviewed PR.",
      "matchPackagePatterns": ["^pytest"],
      "groupName": "Python development tools",
      "groupSlug": "python-dev-tools",
      "schedule": ["before 7am on monday"],
      "minimumReleaseAge": "3 days",
      "automerge": false,
      "addLabels": ["dependencies", "python", "needs-manual-review"]
    },
    {
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "description": "Group Docker digest refreshes into one weekly reviewed PR. Digest churn is normal, but daily one-image PRs add CI load without improving safety.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Docker image digest updates",
      "groupSlug": "docker-digests",
      "schedule": ["before 7am on monday"],
      "minimumReleaseAge": "3 days",
      "automerge": false,
      "addLabels": ["dependencies", "docker-digest", "needs-manual-review"]
    },
    {
      "description": "Batch Playwright monorepo updates weekly so Browser CI image refreshes are deliberate and reuse the fingerprint-cache path instead of producing daily PR pressure.",
      "matchPackageNames": ["@playwright/test", "playwright"],
      "groupName": "Playwright monorepo",
      "groupSlug": "playwright-monorepo",
      "schedule": ["before 7am on monday"],
      "minimumReleaseAge": "3 days",
      "automerge": false,
      "addLabels": ["dependencies", "playwright", "needs-manual-review"]
    },
    {
      "description": "Docker OS base-image bumps (ubuntu, debian, alpine…) must pass CI before merging. They can break compiled binaries, rename packages, or change system defaults. Renovate creates the PR; a human merges after CI is green.",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^ubuntu$", "^debian$", "^alpine$"],
      "automerge": false,
      "addLabels": ["needs-manual-review", "docker-base-image"]
    },
    {
      "description": "Hold OPCFoundation.NetStandard.Opc.Ua major updates until IJT C# companion types and build profiles are migrated to Roslyn source generation for SDK 2.0. See PR #598 for context.",
      "matchPackageNames": [
        "OPCFoundation.NetStandard.Opc.Ua",
        "OPCFoundation.NetStandard.Opc.Ua.Core"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
