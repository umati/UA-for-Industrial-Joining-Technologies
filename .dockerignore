# Keep repo-root Docker builds small. The Web Client and Browser CI image use
# the repo root as build context.
*

!.github/
.github/*
!.github/docker/
.github/docker/*
!.github/docker/ijt-browser-ci/**

!OPC_UA_Clients/
OPC_UA_Clients/*
!OPC_UA_Clients/Release2/
OPC_UA_Clients/Release2/*
!OPC_UA_Clients/Release2/IJT_Web_Client/**

# Allow shared runtime tooling and session policy in the Web Client base image,
# plus readiness support in its test stage.
!scripts/
scripts/*
!scripts/ijt_live_readiness.py
!scripts/opcua_session_policy.py
!scripts/opcua_session_policy_loader.py
!scripts/tool_bootstrap.py

**/__pycache__/
**/*.py[cod]
**/.venv/
**/.venv_test/
**/.venv_ci/
**/venv/
**/venv_test/
**/node_modules/
**/logs/
**/.state/
**/tmp/
**/test-results/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# Local runtime resources are generated from committed *.default.json templates
# and may contain developer-specific/private endpoints. Never bake them into
# Docker images built from the repo root.
OPC_UA_Clients/Release2/IJT_Web_Client/src/resources/connectionpoints.json
OPC_UA_Clients/Release2/IJT_Web_Client/src/resources/connectionpoints.json.*
OPC_UA_Clients/Release2/IJT_Web_Client/src/resources/settings.json
OPC_UA_Clients/Release2/IJT_Web_Client/src/resources/settings.json.*
